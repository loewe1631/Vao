{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vao",
  "version": "0.2.5",
  "identifier": "app.vaovao.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Vao",
        "width": 1080,
        "height": 780,
        "minWidth": 820,
        "minHeight": 650,
        "center": true,
        "visible": true
      },
      {
        "label": "voicebar",
        "url": "index.html?bar=1",
        "title": "Vao Voice Bar",
        "width": 380,
        "height": 148,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "visible": false,
        "focus": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
