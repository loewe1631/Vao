{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vao",
  "version": "0.2.6",
  "identifier": "app.vaovao.windows",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/windows.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../PROVENANCE.md": "PROVENANCE.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/",
      "../docs/WINDOWS.md": "WINDOWS.md",
      "../docs/WINDOWS_UPDATES.md": "WINDOWS_UPDATES.md",
      "../docs/WINDOWS_NOTICES.md": "WINDOWS_NOTICES.md"
    },
    "shortDescription": "Voice input, refinement and translation",
    "windows": {
      "nsis": {
        "installerIcon": "icons/windows.ico",
        "uninstallerIcon": "icons/windows.ico",
        "headerImage": "icons/windows-header.bmp",
        "sidebarImage": "icons/windows-sidebar.bmp",
        "installerHooks": "../scripts/windows-installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
